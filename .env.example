# ---- Discord ----
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# Application (client) ID from the General Information tab
DISCORD_CLIENT_ID=
# Optional: set a guild ID to register slash commands instantly in that server.
# Leave blank to register globally (can take up to an hour to appear).
DISCORD_GUILD_ID=
# Prefix for legacy text commands
BOT_PREFIX=!
# Bot presence activity (shown as "Playing <value>")
BOT_STATUS=/check
# Optional allowlist: comma/space-separated guild (server) IDs the bot may
# respond in. Blank = every server (and DMs). When set, messages and
# interactions from any other server are refused, DMs are ignored, and slash
# commands are registered directly in each listed guild.
ALLOWED_GUILD_IDS=

# ---- Copyright engine (looney-checks) ----
# The bot starts one warm engine server and keeps it running. Start-up on an
# Intel Mac takes ~1 minute (PyInstaller cold start), so this is done once.
# Path to the engine executable. Relative paths resolve from the project root.
# v0.3.1+ is an onedir bundle (extracted from the release archive) and starts in ~1s.
# Fetch it with: npm run fetch-engine
LOONEY_BIN=vendor/music-copyright-checker-0.3.1-macos-x86_64/music-copyright-checker
# Faster alternative on a machine that has the looney-checks source checked out:
# LOONEY_BIN=/Users/techspot/looney-checks/.venv/bin/music-copyright-checker-server
# Port for the managed engine server (must be free on this machine)
LOONEY_PORT=8799
# openrouter (default, needs OPENROUTER_API_KEY), opencode-go (needs
# OPENCODE_GO_API_KEY), openai-compatible (Token Harbor et al., needs
# TOKEN_HARBOR_*), or opencode (needs the opencode CLI on PATH)
LOONEY_AI_BACKEND=openrouter
# Secondary backend(s) tried if the primary fails, in order, comma/space
# separated (e.g. "openai-compatible" for Token Harbor).
LOONEY_FALLBACK_BACKENDS=
LOONEY_MODEL=openrouter/free
# Engine retries on the SAME backend for a transient failure (empty completion,
# truncated/invalid JSON, 429/5xx, dropped socket) before advancing the chain.
# Default 1. Also settable as MUSIC_CHECKER_FALLBACK_RETRIES.
LOONEY_FALLBACK_RETRIES=
# Web search mode: auto (provider's server tool when available, Exa otherwise),
# server, exa, or none. The openai-compatible backend has no server tool, so
# auto resolves to Exa there.
LOONEY_SEARCH_BACKEND=auto
# Per-request AI research timeout (seconds)
LOONEY_TIMEOUT=300
# Use the engine's async /jobs API (recommended: long AI runs no longer hold a
# single HTTP connection, and the bot can show live progress). Set false only if
# you point LOONEY_URL at a server started without --jobs.
LOONEY_JOBS=true
# How long the bot waits for a job to finish (ms)
LOONEY_REQUEST_TIMEOUT_MS=780000
# How long to wait for the engine to boot before giving up (ms)
LOONEY_STARTUP_TIMEOUT_MS=240000
# Transient AI failures (free-router "empty completion", truncated JSON, 5xx,
# 429, dropped sockets) are retried automatically. Total attempts per check
# (1 = no retries) and the time budget for the whole retry sequence (ms).
LOONEY_RETRY_ATTEMPTS=3
LOONEY_RETRY_BUDGET_MS=600000
# ---- Token Harbor (OpenAI-compatible gateway) ----
# Used as the primary backend when LOONEY_AI_BACKEND=openai-compatible. Any
# OpenAI-compatible endpoint works; these are Token Harbor's defaults.
TOKEN_HARBOR_BASE_URL=https://tokenharbor.ai/v1
# Model id from GET /v1/models, e.g. mimo-v2.5:free or th-orchestra
TOKEN_HARBOR_MODEL=
# thk_live_... key; forwarded to the engine as OPENAI_COMPAT_API_KEY
TOKEN_HARBOR_API_KEY=
# Exa web search key (the engine's client-side search for openai-compatible)
EXA_API_KEY=

# ---- Engine credentials (forwarded to the engine process) ----
OPENROUTER_API_KEY=
# OpenCode Go ("zen/go") API key, for LOONEY_AI_BACKEND=opencode-go
OPENCODE_GO_API_KEY=
YOUTUBE_API_KEY=
# Optional: point at an already-running engine server instead of spawning one
# LOONEY_URL=http://127.0.0.1:8787
# Optional: LOONEY_NO_CACHE=true  /  LOONEY_CACHE_PATH=/path/to/cache.sqlite3
# Optional: LOONEY_NO_AI=true to skip AI research (metadata only, for smoke tests)

# ---- Behaviour ----
# Max size of an uploaded file kept in memory for the "refresh" button
MAX_CONTEXT_FILE_BYTES=26214400

# ---- Queue ----
# How many checks may run at once; extra checks wait and see their queue
# position. The engine runs each job in its own thread, so >1 is real parallelism.
QUEUE_CONCURRENCY=2

# ---- Database + usage limits ----
# JSON file (created automatically). Relative paths resolve from the project root.
DB_PATH=data/renderbot.json
# Daily per-user check limit (resets at 00:00 UTC)
QUOTA_DAILY_LIMIT=5
# Comma/space-separated Discord user IDs that bypass the daily limit
QUOTA_BYPASS_USER_IDS=
# Keep daily usage rows for this many days
DB_RETENTION_DAYS=30
# SQLite audit log of every check (who, where, request, answer, cache hit).
# Created automatically. Relative paths resolve from the project root.
AUDIT_DB_PATH=data/requests.sqlite3

# ---- Public checks API ----
# Read-only HTTP API over completed checks (track + answer + cache flag only;
# no Discord user/avatar/guild). Bind to localhost and expose it via a tunnel
# or reverse proxy. See AGENTS.md for wire format.
API_ENABLED=false
API_HOST=127.0.0.1
API_PORT=8800
# Max requests per minute per client IP (0 disables the limiter)
API_RATE_LIMIT_PER_MINUTE=120
# Trust X-Forwarded-For from the reverse proxy when identifying clients
API_TRUST_PROXY=true
